# Public hostname. Its DNS A/AAAA record must point to the beta server.
DARSM_DOMAIN=dars.example.org
DARSM_RELEASE=beta-2026-09
DARSM_LOG_LEVEL=INFO
DARSM_HTTP_PORT=80
DARSM_HTTPS_PORT=443

POSTGRES_DB=dars_manager
POSTGRES_USER=dars_manager

# Host paths read by Docker Compose. Never put secret values in this file.
DARSM_POSTGRES_PASSWORD_FILE=./secrets/postgres_password
DARSM_OPENAI_API_KEY_FILE=./secrets/openai_api_key
DARSM_SMTP_PASSWORD_FILE=./secrets/smtp_password

# Invitations de comptes. Renseigner ces valeurs après validation du domaine
# auprès d'un fournisseur SMTP. Le mot de passe reste dans le fichier secret.
DARSM_SMTP_HOST=
DARSM_SMTP_PORT=587
DARSM_SMTP_USERNAME=
DARSM_SMTP_STARTTLS=true
DARSM_SMTP_SSL=false
DARSM_EMAIL_FROM=Dars Manager <accounts@dars-manager.com>
DARSM_INVITATION_TTL_SECONDS=172800
DARSM_CLIENT_SESSION_TTL_SECONDS=86400
DARSM_ADMIN_SESSION_TTL_SECONDS=14400

DARSM_WHISPER_CPU_THREADS=4
DARSM_SEMANTIC_ANALYSIS_BACKEND=openai
DARSM_SEMANTIC_ANALYSIS_MODEL=gpt-5.6-luna
DARSM_IMAGE_GENERATION_MODEL=gpt-image-2.5-sunburst
DARSM_IMAGE_GENERATION_QUALITY=medium
DARSM_JOB_TTL_SECONDS=7200
DARSM_MAX_UPLOAD_BYTES=524288000
DARSM_MEDIA_BACKEND=local
DARSM_MEDIA_ROOT=/workspaces/media
DARSM_MEDIA_RETENTION_SECONDS=604800
DARSM_MEDIA_UPLOAD_URL_TTL_SECONDS=900
DARSM_WORKER_POLL_SECONDS=2
DARSM_WORKER_LEASE_SECONDS=120
DARSM_WORKER_MAX_ATTEMPTS=3
DARSM_MAINTENANCE_INTERVAL_SECONDS=3600
DARSM_STORAGE_PROVIDER=local
DARSM_STORAGE_MODEL=temporary-standard
DARSM_STORAGE_GB_MONTH_USD=0
DARSM_STORAGE_PRICE_SOURCE_URL=

# Production object storage. Prefer an instance role/workload identity over
# long-lived AWS keys. A credentials file can be mounted separately if the
# selected host does not support workload identity.
# DARSM_MEDIA_BACKEND=s3
# DARSM_S3_BUCKET=dars-manager-media
# DARSM_S3_REGION=eu-west-3
# DARSM_S3_ENDPOINT_URL=
# DARSM_STORAGE_PROVIDER=aws
# DARSM_STORAGE_MODEL=s3-standard
# DARSM_STORAGE_GB_MONTH_USD=<current-provider-rate>
# DARSM_STORAGE_PRICE_SOURCE_URL=<provider-pricing-page>
